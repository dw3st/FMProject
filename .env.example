# Copy to .env and fill in for production. Bun auto-loads .env.
# With no SMTP2GO_API_KEY set, login-code emails fall back to the dev log
# (console + src/Data/email-log.json) — no credentials needed for local dev.

# SMTP2GO HTTP send API key (https://app.smtp2go.com → Settings → API Keys).
# When set, login codes are delivered as real email via SMTP2GO.
SMTP2GO_API_KEY=

# Sender address — must be a verified sender / domain in SMTP2GO.
EMAIL_FROM=login@yourdomain.com

# Optional display name shown as the sender.
EMAIL_FROM_NAME=FMProject

# Where runtime state (game saves + auth DB fmproject.db) is written. Defaults
# to src/Data for local dev. In production set this to a PERSISTENT volume mount
# (e.g. /app/persistent in Docker) so saves and logins survive redeploys.
RUNTIME_DATA_DIR=

# PostHog product analytics. Optional — analytics only initialises when
# POSTHOG_KEY is set. The project key is a public client token (safe to expose).
POSTHOG_KEY=
# PostHog Cloud region host (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com).
# Defaults to the US host when unset.
POSTHOG_HOST=https://us.i.posthog.com
